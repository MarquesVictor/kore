# Copie este arquivo para ".env" e ajuste os valores.
# Variáveis com prefixo VITE_ ficam disponíveis no código via import.meta.env.
# Atenção: elas são embutidas no build — não coloque segredos aqui.

# Domínio público do site, sem barra no final ("https://" é completado se faltar).
# Usado nas URLs absolutas de Open Graph (imagem de compartilhamento) e canonical.
VITE_SITE_URL=https://www.exemplo.com.br

# Destino dos botões "Começar agora" (cadastro / trial).
# Se ficar vazio, os botões levam para a seção #planos.
VITE_APP_URL=https://app.exemplo.com/cadastro

# Destino do botão "Entrar" (login).
# Se ficar vazio, o link fica como "#".
VITE_LOGIN_URL=https://app.exemplo.com/login

# WhatsApp de contato: só números, com DDI (55) + DDD + número.
# Vira o link https://wa.me/<número> no ícone do WhatsApp.
# Se ficar vazio, o ícone abre o WhatsApp sem um contato definido.
VITE_CONTACT_WPP=5511999999999

# Só no servidor: pasta que o Apache serve (DocumentRoot), usada pelo `npm run deploy`.
# Sem prefixo VITE_, então não vai para o código do site. Deve ser exclusiva do site:
# o deploy apaga dela o que não existe mais no build (ver docs/deploy.md).
# DEPLOY_DIR=/var/www/korebr.com/public_html
